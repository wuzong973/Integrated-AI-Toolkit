# ============================================================================
# 《青智校园》环境变量样例  ——  复制为 .env 后按需填写
# 说明：完整填写要求见 docs/dev/ENV.md
# 纪律：本文件可入库；.env 严禁入库（.gitignore 已忽略）
# ============================================================================

# ---------- 1. 运行环境 ----------
# 运行模式：development | production | test
NODE_ENV=development
# 服务端口
PORT=3000
# API 全局前缀（文档 9.1）
API_PREFIX=/api/v1
# 接口版本号（/health 返回）
APP_VERSION=0.1.0

# ---------- 2. Provider 模式（红线 9 / 10，关键） ----------
# mock   = 全部使用模拟实现，响应头带 X-Provider: mock，界面显示"演示模式"
# real   = 全部使用真实实现（需填好下方各第三方 Key）
# hybrid = 混合（推荐）：FFmpeg/Sharp 等开源实现走真实，付费/GPU 能力走 Mock
PROVIDER_MODE=hybrid

# ---------- 3. 数据库 MySQL 8 ----------
DATABASE_URL=mysql://qz:qz_dev_password@localhost:3306/qingzhi
# 影子库（仅 prisma migrate dev 使用；生产 migrate deploy 会忽略）
SHADOW_DATABASE_URL=mysql://qz:qz_dev_password@localhost:3306/qingzhi_shadow
# 连接池上限
DB_POOL_MAX=10

# ---------- 4. Redis 7 ----------
REDIS_URL=redis://localhost:6379
# 队列实现：redis-stream（起步，默认）| rabbitmq（规模化后切换）
QUEUE_DRIVER=redis-stream
# 队列 Worker（M1-04）
#   QUEUE_WORKER_CONCURRENCY 单队列并发数（验收项"并发数可配置"）
#   QUEUE_MAX_ATTEMPTS       同一消息最多投递几次，超过转入死信流 `${前缀}:${队列}:dead`
#   QUEUE_CLAIM_IDLE_MS      超过该时长未确认的消息视为消费者已失联，由其他 Worker 认领重投
#                            —— 即"Worker 被强杀后任务多久重回队列"（不得小于任务典型耗时）
#   QUEUE_ORPHAN_QUEUED_MS   卡在 queued 超过该时长即视为"入队消息丢失"，重新投递
#                            （覆盖 Redis 不可用期间重启、写库与 XADD 之间被杀两种情况）
QUEUE_WORKER_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_CLAIM_IDLE_MS=60000
QUEUE_ORPHAN_QUEUED_MS=60000

# ---------- 5. 对象存储 ----------
# 存储实现：local | minio | oss | cos
#   local  —— 本地文件系统，**开发默认**，不依赖任何外部服务
#   minio  —— S3 协议（注意：MinIO 开源版已归档、官方不再分发，仅作兼容性验证用）
#   oss/cos —— 生产用；当前**未实现**，接入时需接各自官方 SDK 并实测
STORAGE_DRIVER=local
# local 驱动的落盘目录（已 gitignore）
# ⚠️ 相对路径会**锚定到 apps/api/**（不是 process.cwd()）。曾经按 cwd 解析，
#   换个启动方式存储根就变，导致"文件在磁盘上、数据库也有记录，下载却 404"。
#   详见 configuration.ts 的文件头注释。想放别处请写绝对路径。
LOCAL_STORAGE_DIR=./data/uploads
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=cn-hangzhou
STORAGE_BUCKET=qingzhi-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# 预签名 URL 有效期（秒）
STORAGE_PRESIGN_EXPIRE=900
# 公开访问基址（小程序直传 / 下载用）—— **必须带 `/api/v1` 前缀**。
#   留空 → 回落 `http://localhost:{PORT}{API_PREFIX}`，**真机上 localhost 指向手机自己，必失败**。
#   真机调试填本机局域网 IP，例如：http://192.168.1.100:3000/api/v1
#   ⚠️ DHCP 环境下 IP 会变：真机连不上时先回来核对这一项。
STORAGE_PUBLIC_BASE_URL=

# ---------- 6. JWT 鉴权 ----------
# 生产环境必须替换为随机 64 位以上字符串
JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_ACCESS_EXPIRE=2h
JWT_REFRESH_EXPIRE=30d

# ---------- 7. 微信小程序 ----------
# AppID 不是机密（会随小程序发布公开），可以直接带；AppSecret 一律留空，由每人本地填
WECHAT_APPID=wxd89a1e87830e5821
# 小程序 AppSecret（微信公众平台 → 开发管理 → 开发设置）——严禁入库
WECHAT_SECRET=
# 登录接口地址（一般无需修改）
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
# 是否**强制**走开发模式的伪 openid（即使已配好真实 AppSecret）。
#   用途：本地自测与 `npm run verify:*` 脚本都用假 code 登录；填了真 Secret 后
#   假 code 会被微信拒（40029），脚本全部 401 —— 开这个开关即可恢复。
#   ⚠️ NODE_ENV=production 时强制失效，上线前请保持 false。
WECHAT_DEV_LOGIN=false
# 订阅消息模板 ID（消息通知用，M3-19；留空则仅发站内信）
WECHAT_SUBSCRIBE_TEMPLATE_TASK=
WECHAT_SUBSCRIBE_TEMPLATE_ORDER=
WECHAT_SUBSCRIBE_TEMPLATE_JOB=

# ---------- 8. 微信支付 v3（M3-12 / M5-07） ----------
# 未配置时自动降级为 MockPayProvider，并带 X-Provider: mock
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/pay/callback/wechat

# ---------- 9. 大模型（LLMProvider） ----------
# 模型路由实现：openai-compatible | mock
LLM_DRIVER=openai-compatible
# 兼容 OpenAI 协议的任意服务：DeepSeek / 通义 / 智谱 / vLLM 等
# **本项目当前实配智谱**（2026-09-18 切回）：账号有 glm-4.5-air 的资源包额度
# （企微 1000 万 + 新用户 1200 万 ≈ 2200 万 tokens），到期前零现金成本。
# ⚠️ 与 OCR / 语音 / 向量**不是同一家**：那三项走硅基流动（SILICONFLOW_* 变量），
#   两个 Key 并存，改配置时别看错行。
# ⚠️ 额度到期时间：企微包 2026-10-18、新用户包 2026-12-06。到期后自动扣现金余额，
#   届时切回硅基流动（备用配置在本节末尾）。
# 选型与实测全表见 docs/dev/AI-PROVIDER-CONFIG.md（含被淘汰候选及原因）。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
# 模型分级（文档 6.10.2）：三档统一 `glm-4.5-air`（2026-09-18 起）。
#   128K 上下文，支持工具调用与 JSON 结构化输出（返回带 ```json 围栏，靠 extractJson 清洗）；
#   短请求 0.9~1.2s，与硅基 DeepSeek-V4-Flash 相当；长输出偏慢但在 60s 验收线内。
#   历史淘汰结论（跨服务商通用，别重复踩）：
#     · stepfun-ai/Step-3.5-Flash 便宜但**不支持 JSON mode**（code 20024）→ 意图档全挂；
#     · Qwen/Qwen3.5-9B 连消息协议都不兼容（system message 必须在开头，400）；
#     · DeepSeek-V3.2 / glm-4-flash 会**编造平台没有的功能**（红线 9），排除。
#   → 便宜必须先过"这项功能用得上"这一关，再比价格。
LLM_MODEL_INTENT=glm-4.5-air
LLM_MODEL_GENERATE=glm-4.5-air
LLM_MODEL_PLAN=glm-4.5-air
# 降级模型（逗号分隔）：主模型重试耗尽后按顺序再试。
#   ✅ 当前 `glm-4.7-flash`（同服务商、永久免费档）。
#   ⚠️ **它是"时段性可用"，不是"稳定可用"** —— 09-19 实测两批：
#      · 10 次连打：**8/10 成功**（1.1~2.9s），1 次 429 过载、1 次 content 为空（token 被推理吃光）
#      · 同一小时内另一批 2 次连打：**2/2 全部 429**（「该模型当前访问量过大」）
#      → 高峰期过载率明显上升，**只有多时段采样才能得到真实可用率**。
#   ⚠️ 排查提示：**别用一两次 429 就判定"这个模型不能用"**。降级链的价值是
#      "80% 能兜住"，不是"100% 能兜住" —— 而留空是 0%。
#   ⛔ 不要换成 `glm-4-flash`：它可用率更高（6/6），但**已知会编造不存在的链接**
#      （见 AI-PROVIDER-CONFIG「被淘汰的候选」）—— 选型第一关永远是**不编造**，不是可用率。
#   ✅ 更好的候选：`glm-5.3-flash`（09-18 实测质量合格、2~13s），但当前账号报
#      `code 1113 余额不足或无可用资源包`；充值后可切。
#   ⚠️ 降级只在 429 / 5xx 上触发；**额度耗尽、Key 失效是 4xx 确定性失败，
#      不会重试也不会降级** —— 额度到期前要主动换主模型，别指望降级链救场。
LLM_FALLBACK_MODELS=glm-4.7-flash
# 超时与重试
#   ⚠️ LLM_TIMEOUT_MS 必须 **≤ LLM_TOTAL_BUDGET_MS**（启动期断言，配错拒绝启动）。
#      attemptTimeout() 取两者较小值：单次超时大于总预算时，第一次尝试就吃掉全部预算，
#      等它超时回来已无额度重试、也来不及降级 —— 表现为"重试机制形同虚设"。
#      实测踩坑（2026-09-18）：作业卡满 45.028s 失败，日志里没有任何降级记录。
#   30s 的依据：长输出（800 字）约 12s、plan 档约 21s，首次挂起后还剩 ~15s 重试。
#   ⚠️ 与 LLM_TOTAL_BUDGET_MS 的关系见下方；两者还共同受"服务端预算 < 客户端超时"约束。
#   默认 12s 的依据：关掉思考后长输出实测 3.6~12s —— 单次超时只需覆盖"正常慢请求"，
#   明显更慢的请求应当交给总预算内的重试与降级，而不是靠拉长单次超时硬等。
LLM_TIMEOUT_MS=12000
LLM_MAX_RETRY=3
# 单次逻辑调用的**总时间预算**（毫秒），覆盖"所有模型 × 所有重试 × 所有退避"的总和。
#   ⚠️ 超时是乘法放大的：当前配置 = 2 个模型（glm-4.5-air + 降级 glm-4.7-flash）
#   ×(3 次重试 × 30s + 退避 1s+4s) = 最坏 190 秒；
#   而小程序请求超时只有 30 秒 → 前端早断了，后端还在继续打请求烧配额。
#   加了这个上限后，无论怎么配上面两个值，一次逻辑调用的墙钟时间都不会超过它。
#   取值：必须明显小于小程序请求超时（30s）才有意义。默认 45s 给"大纲生成"留余量；
#   意图识别这类交互式调用建议压到 8~12s。
#   ⚠️ 必须 **小于小程序请求超时（30s）减 5s 回程余量**，即 ≤ 25s；
#   启动期由 `assertBudgetWithinClientTimeout` 断言，配大了拒绝启动。
#   为什么：服务端预算比客户端超时大时，用户会先看到"请求超时"，
#   而服务端仍在跑、还会落库扣费 —— 客户端判失败、服务端判成功，两边不一致。
#   默认 25s（可用上限）：给长任务留最大空间，同时保证响应能回到客户端。
LLM_TOTAL_BUDGET_MS=25000
# 推理深度。⚠️ **provider 级配置，对所有档位同时生效**（不区分模型）。
#   取值随服务商不同，**别照搬另一家的结论**：
#     · 智谱（当前）：只认 low / high / max，传 medium / minimal 会 400（code 1210）；
#       env.schema.ts 已收紧枚举，填错在**启动时**报错而不是每次请求 400。
#       2026-09-18 实测 glm-4.5-air 带 low 正常，content 干净、不 400。
#     · 硅基流动 DeepSeek-V4-Flash：同样只认三值，但 ⚠️ 带该参数时短输出会
#       泄漏 `</think>` + 内容重复 → **切过去时必须清空本行**（见备用 A）。
#   实测对推理型模型是决定性的：不传时对话烧 1500 字推理 / 6.9s、
#   大纲烧 3115 字 / 24.8s；设 low 后推理降到 0 字、对话 2.3s、大纲 6.4s。
#   → 说"某模型太慢"之前，先确认这个全局参数调没调。
LLM_REASONING_EFFORT=low
# ---------- 关闭思考 ----------
#   语义：是否**允许**发送 `thinking:{type:'disabled'}`（智谱 GLM 的关闭思考参数）。
#   ⚠️ 它管的是"允不允许发这个参数"，**不是**"要不要思考" —— 关不关由调用方决定，
#   目前只有 `generate_mindmap` 这类"结构固定、不需要推理"的重生成工具会请求它。
#
#   为什么还需要它：上面 `LLM_REASONING_EFFORT` 的效果**强依赖任务复杂度** ——
#   简单任务（对话 / 大纲）实测能压到 0 字推理，但**复杂生成任务压不住**：
#   思维导图实测 reasoning 仍占 token 的 60~75%、耗时 23.6~31.1s，
#   恰好在 30s 单次超时线上反复横跳（表现为"时通时不通"）。
#   显式关思考后：reasoning 归零、耗时 **3.6s**、completion_tokens 2016 → 314。
#
#   ⚠️ 换到不认识的端点若报 400，把它设为 false（Provider 会跳过发送，不必改代码）。
#   ⚠️ **更老的**智谱 flash 系列会报 `code 1210 该模型始终思考，不支持关闭思考`；
#      当前用的 glm-4.5-air / glm-4.7-flash 均已实测接受。
LLM_DISABLE_THINKING=true
# ---------- 备用 A：硅基流动（智谱额度到期/用尽，或智谱不可用时切回）----------
#   取消注释下面几行，并把上面 LLM_ 那几行注释掉即可。
#   2026-09-18 实测：deepseek-ai/DeepSeek-V4-Flash 意图/对话/大纲三档全通过，
#   延迟 2.1s，代价是 ¥1/¥2 每百万（付费、无免费额度）。
#   ⚠️ 切过去时**必须把上面的 LLM_REASONING_EFFORT 清空**（会泄漏 </think>）。
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=
# LLM_MODEL_INTENT=deepseek-ai/DeepSeek-V4-Flash
# LLM_MODEL_GENERATE=deepseek-ai/DeepSeek-V4-Flash
# LLM_MODEL_PLAN=deepseek-ai/DeepSeek-V4-Flash
# LLM_REASONING_EFFORT=
#
# ---------- 备用 B：智谱**永久免费**档（不消耗资源包额度）----------
#   资源包用尽后想继续零成本，切这三行即可（200K 上下文 / 128K 输出）。
#   注意：免费档按用户权益等级限并发，高峰期可能被限流；
#   且是推理型，max_tokens 过小时会返回空 content。
# LLM_MODEL_INTENT=glm-4.7-flash
# LLM_MODEL_GENERATE=glm-4.7-flash
# LLM_MODEL_PLAN=glm-4.7-flash

# ---------- 10. AI 媒体服务（services/ai、services/media） ----------
AI_SERVICE_URL=http://localhost:8000
MEDIA_SERVICE_URL=http://localhost:8001
# 图表渲染（Mermaid / markmap → PNG 分享图）：mock（默认）= 不渲染、不新增产物；
# playwright = media 侧车截图出图。开启前提：侧车已执行
#   pip install playwright && playwright install chromium --with-deps
# （中文字体包必须装，否则渲染出的中文全是方块）。渲染失败不影响文本产物。
RENDER_PROVIDER=mock
# edge-tts 可执行文件（LGPLv3，须装在仓库外的独立 venv；留空则 /media/tts 返回 501）
MEDIA_TTS_BIN=
# FFmpeg / ffprobe 可执行文件（**给 services/media 侧车用**，后端自己不调）。
#   ⚠️ 必须是 **LGPL 构建**：断言脚本会检查 `-buildconf` 里不出现 `--enable-gpl`。
#   留空则按 PATH 查找；没装进 PATH 就显式写绝对路径（用正斜杠，避免转义问题）。
FFMPEG_BIN=
FFPROBE_BIN=
# 抠图模型白名单（文档 2.8.4，禁止改成许可受限的模型）
REMBG_MODEL=u2net
# 人声分离：demucs（首版，注意原仓库已归档）| spleeter（备选）
VOCAL_SEPARATION_ENGINE=demucs
# 语音转文字模型规格：tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# GPU 任务并发上限（文档 6.2.4）
GPU_CONCURRENCY=1

# 侧车客户端的超时。⚠️ 两个值量级不同，不要合并成一个：
#   AI（抠图）—— 首次调用要加载 u2net 权重（秒级），之后单张图秒级
#   媒体（转码/压缩）—— 分钟级；用 120s 会把"正常的十分钟视频压缩"判成超时
AI_SERVICE_TIMEOUT_MS=120000
MEDIA_SERVICE_TIMEOUT_MS=600000
# 人声分离单独的超时（第三个量级）。Demucs 在 CPU 上要跑"音频时长的 1~3 倍"，
# 复用 120s 会把**正常且最终会成功**的分离判成超时
AI_SEPARATION_TIMEOUT_MS=900000
# 单次 ffmpeg 调用的墙钟上限（给的是侧车，不是后端）
FFMPEG_TIMEOUT_SEC=600
# 侧车单次请求体上限（MB）。侧车入参是整段音视频二进制，所以默认给得较大
SIDECAR_MAX_BODY_MB=512
# 侧车的阶段标记，进 X-Service-Stage 响应头与 /health。
#   skeleton = 只有 501 占位；beta = 能力已实现但未全量；live = 生产
#   ⚠️ 能力做完后必须改掉它，否则监控里"已完成的服务"仍显示为骨架
SERVICE_STAGE=beta

# ---------- 10b. 硅基流动 SiliconFlow（多模态 / OCR / 语音，共用一个 Key） ----------
# 控制台取 Key：https://cloud.siliconflow.cn/me/account/ak
# 留空则 OCR 与语音转文字回退 Mock（响应头带 X-Provider: mock）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
# OCR / 图片理解。⚠️ 模型名必须带组织前缀，写成 qwen3.5-4b 会 404。
# 实测：deepseek-ai/DeepSeek-OCR 输出最干净（1.3s）；
#       PaddlePaddle/PaddleOCR-VL-1.5 带 <|LOC_x|> 版面坐标（2.1s），需要位置信息时切换
VLM_MODEL=deepseek-ai/DeepSeek-OCR
# OCR 实现切换：cloud = 硅基流动 VLM（默认）；selfhost = 转发 AI 侧车（services/ai，PaddleOCR）。
#   · selfhost 要求 AI_SERVICE_URL 已配置且侧车在跑、依赖已装（faster-whisper / paddleocr）；
#   · selfhost 而 AI_SERVICE_URL 为空时回落 Mock（X-Provider: mock，红线 10）；
#   · selfhost 超时用 AI_SERVICE_TIMEOUT_MS（120s），首次调用要下载 PaddleOCR 模型属正常。
OCR_PROVIDER=cloud
# 是否发送 enable_thinking：留空=不发送（默认，最安全）。
# ⚠️ DeepSeek-OCR 收到该参数会 400，所以默认必须留空；
#    只有改用 Qwen/Qwen3.5-4B 这类混合思考模型时才设为 false（否则会先思考，慢 10 倍）
VLM_ENABLE_THINKING=
VLM_TIMEOUT_MS=90000
VLM_MAX_RETRY=2
# 语音转文字。⚠️ 实测走 POST /audio/transcriptions（multipart），不是 /chat/completions
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# ASR 实现切换：cloud = 硅基流动（默认）；selfhost = 转发 AI 侧车（services/ai，faster-whisper）。
#   · selfhost 要求 AI_SERVICE_URL 已配置且侧车在跑（同 OCR_PROVIDER 的回落规则）；
#   · selfhost 收益是逐句时间戳（云端只回整段文本）与零按次计费；
#   · ⚠️ CPU 转写约需音频时长的 0.1~1 倍，ASR_TOTAL_BUDGET_MS 默认 25s 对长音频偏紧，
#     切 selfhost 后频繁超时应调大该预算（仍受"≤ 小程序超时 30s − 5s"启动断言约束）。
ASR_PROVIDER=cloud
# 单次请求超时。⚠️ 曾经是 120000（2 分钟），而实测成功耗时只有 78~97ms ——
#   比真实耗时大了三个数量级。供应商偶发挂起（约 35% 的调用）时，
#   用户要干等两分钟才看到失败，而且每次都照样消耗额度。现压到 20s。
ASR_TIMEOUT_MS=20000
# 额外重试次数（不含首次）。挂起是**间歇性**的：同一次音频第一次超时、
#   第二次 78ms 就成功 —— 典型"重试即成功"的故障形态，不重试等于丢掉三成可用性。
#   ⚠️ 语义与 LLM_MAX_RETRY 不同：那个是"总尝试次数"，这个是"额外次数"。
ASR_MAX_RETRY=1
# 单次逻辑调用的总预算，保证"重试 × 超时"不超出小程序请求超时（30s）。
#   2 次尝试 × 20s = 40s > 30s，没有这个上限前端会先断开。
ASR_TOTAL_BUDGET_MS=25000
# 向量化（语义检索 / RAG 用）。⚠️ EMBEDDING_DIMENSION 必须与模型真实维度一致，
# 填错不会报错、只会静默算出错误结果。bge-m3 = 1024 维（实测 146ms）
# 换 Qwen/Qwen3-Embedding-8B 之类要同步改成 4096
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_MAX_RETRY=2

# ---------- 10c. 向量库 + RAG 检索（M4-06 校园知识库） ----------
# 为什么需要**独立的向量库**：本项目已拍板统一用 MySQL 8，而 MySQL 既没有向量类型、
#   也没有 ANN 索引。把 1024 维向量存进 Json 列，检索只能全表捞出来在应用层算余弦 ——
#   几百条还行，上万条就是一次接口几十秒。KnowledgeDoc.embedding 那个 Json 列是
#   初版 schema 的过渡设计，已被本方案取代（字段保留但不写入）。
#
# 实现：mock（默认）| qdrant（自建，推荐）
#   ⚠️ 默认 mock 是为了"没部署向量库的机器也能启动"，检索会走 mock-vector 并被打上
#      X-Provider: mock（红线 10）。要用真检索必须**显式**改成 qdrant ——
#      反过来（默认 qdrant）会让所有开发机启动就报连不上。
VECTOR_DRIVER=mock
# Qdrant 地址。自建默认 6333；Qdrant Cloud 填完整 https 地址
QDRANT_URL=http://localhost:6333
# Qdrant 托管版必须填；自建通常留空（不带 api-key 头）
QDRANT_API_KEY=
# 集合名。⚠️ 换 Embedding 模型时要换一个**新集合名**，不要复用（维度不同无法共用）
QDRANT_COLLECTION=qz_knowledge
QDRANT_TIMEOUT_MS=15000

# ---------- 地图 / 位置服务（高德 Web 服务）----------
# mock（默认）= 演示实现：距离按「直线 × 1.4」估算、坐标是 (0, 0)，响应带 X-Provider: mock
# amap        = 真实路线（**必须同时填 AMAP_WEB_KEY**，只改 driver 会回退 mock）
MAP_DRIVER=mock

# ⚠️ 必须是【Web 服务】类型的 key —— 不是「Web端(JS API)」，也不是「微信小程序」。
#    后两种在服务端调用会被拒（返回 INVALID_USER_SCODE，而报错信息里
#    看不出是"key 类型选错了"，很容易以为是代码写错了）。
# ⚠️ 只在服务端使用，绝不下发到小程序（前端明文 key 会被嗅探；
#    小程序端根本不需要它 —— 微信 <map> 组件本身就是腾讯地图，零 key）。
# 申请入口：https://console.amap.com/dev/key/app
AMAP_WEB_KEY=

# 高德请求超时（毫秒）
AMAP_TIMEOUT_MS=8000
# 一次检索取回多少条切片。不是越大越好：切片越多，上下文越长、越贵、越容易被无关内容带偏
RAG_TOP_K=5
# 相似度下限（Cosine 0~1）。⚠️ 它的作用是让"检索不到"成为一件**可以说出口的事** ——
#   没有阈值时，即使知识库完全没有相关内容，也会硬塞 5 条最不相关的切片给模型，
#   模型再据此编出一个听起来很合理的答案，而用户无从分辨。
RAG_SCORE_THRESHOLD=0.35
# 单切片字符数（中文场景 1 字 ≈ 1 token 量级）
RAG_CHUNK_SIZE=500
# 相邻切片重叠字符数，防止一句话正好被切断而语义丢失
RAG_CHUNK_OVERLAP=80

# ---------- 11. 文档转换隔离服务（AGPL/GPL，必须独立部署，文档 2.5 / ADR-05） ----------
# 留空则文档转换相关工具不可用（会返回 50362），绝不回退成"返回原文件"
CONVERT_SERVICE_URL=
# 后端侧（NestJS）等它的超时
CONVERT_SERVICE_TIMEOUT_MS=120000
# 转换服务自己的监听地址，以及引擎可执行文件（装完 LibreOffice / Pandoc 后指向它们）
CONVERT_HOST=0.0.0.0
CONVERT_PORT=8002
SOFFICE_BIN=
PANDOC_BIN=
# 单次转换的墙钟上限（LibreOffice 冷启动本身就 5~15 秒）

# ---------- 11b-2. PDF 能力服务（PyMuPDF 为 AGPL，必须独立安装 + 子进程调用） ----------
# 留空则 PDF 合并 / 拆分 / 压缩 / 文档解析不可用（明确报错，绝不返回假产物）
PDF_SERVICE_URL=
# 后端侧（NestJS）等它的超时
PDF_SERVICE_TIMEOUT_MS=120000
# PDF 服务自己的监听地址，以及**装了 PyMuPDF 的 Python 解释器**（侧车会追加 -m pymupdf）
PDF_HOST=0.0.0.0
PDF_PORT=8003
PYMUPDF_BIN=
# 单次 PDF 操作的墙钟上限
PDF_TIMEOUT_SEC=120
CONVERT_TIMEOUT_SEC=120
# 文档解析引擎：legacy = PyMuPDF 取文本（默认）；docling = 版面/表格/阅读顺序理解（MIT，输出 Markdown）
# ⚠️ 切 docling 前先装侧车依赖：pip install docling（见 services/pdf/requirements.txt）；
#    首次解析会自动下载模型（约数百 MB）；依赖未装时侧车返回 501 与安装指引
DOC_PARSER_PROVIDER=legacy
# docling 模型/管线产物的下载目录（services/pdf 侧车读取，自动创建）
DOCLING_ARTIFACTS_PATH=./data/models/docling

# PDF 操作引擎（合并/拆分/压缩）：sidecar = services/pdf（默认）| stirling = Stirling-PDF
#   ⚠️ 与 DOC_PARSER_PROVIDER 是**两个维度**：本行只选 PdfProvider 的实现；
#   文档解析（parse_document）永远走 services/pdf 侧车，不受它影响。
#   选 stirling 但 STIRLING_SERVICE_URL 为空时按 sidecar 逻辑处理（配了才真，不静默造能力）。
PDF_PROVIDER=sidecar
# Stirling-PDF（自托管 PDF 工具站）服务地址，如 http://localhost:8080；留空 = 不启用。
#   ⚠️ open-core 许可边界：主 LICENSE 为 MIT，但 app/proprietary、engine/、
#   frontend/editor/proprietary 等目录专有 —— 只调用其**社区功能**（合并/拆分/压缩），
#   专有目录的能力不要配置、不要依赖。
STIRLING_SERVICE_URL=
# Stirling-PDF 的 API Key（服务端启用 SECURITY_CUSTOMGLOBALAPIKEY 时才需要，默认留空）
STIRLING_API_KEY=
# Stirling-PDF 单次请求超时（毫秒）
STIRLING_TIMEOUT_MS=120000

# ---------- 仓库解读（deepwiki-open，MIT，自托管部署） ----------
# 服务地址，如 http://localhost:8005；留空 = 不启用。
#   未配置时 explain_repository 回落 mock-repo（产物标注演示性质），
#   seed 里该工具保持 planned；部署并配置后才把 seed 转 active。
DEEPWIKI_BASE_URL=
# 单次仓库解读请求超时（毫秒）。文档生成为分钟级，工具走异步作业（sync:false），
# 不受小程序 30s 请求超时约束，不要把它压进 30s
DEEPWIKI_TIMEOUT_MS=120000
# 可选 Bearer 凭证（自托管实例开启鉴权时才需要）；不配则不发 Authorization 头
DEEPWIKI_API_KEY=

# ---------- 11b. 内容安全（M4-05，红线：必须走微信官方接口） ----------
# mock = 只跑本地词库（仅开发）；wechat = 调 msgSecCheck / mediaCheckAsync
# ⚠️ 生产必须 wechat。mock 拦不住变体与图片，只是让本地链路能跑通
MODERATION_DRIVER=mock
# 场景值：1 资料 / 2 评论 / 3 论坛 / 4 社交日志（驿站任务正文属论坛类）
MODERATION_SCENE=3
MODERATION_TIMEOUT_MS=10000
# access_token 提前刷新窗口（秒）；token 有效期 7200
MODERATION_TOKEN_REFRESH_AHEAD_SEC=300
# 自建补充词库（逗号分隔）。⚠️ 只作补充，不能替代官方接口
MODERATION_EXTRA_WORDS=

# ---------- 11c. 搜索（M4-07） ----------
# mysql = MySQL FULLTEXT（中文必须带 ngram 解析器，见迁移 add_search_index）
# mock  = 内存子串匹配（默认，改动行为不发生在你不知情的时候）
# ⚠️ 切 mysql 前必须先执行数据库迁移，否则查询会直接报错
SEARCH_DRIVER=mock
SEARCH_TIMEOUT_MS=5000

# ---------- 11d. 短信（服务商尚未选型） ----------
# mock = 只打日志不真发；http = 走可配置的 HTTP 网关
SMS_DRIVER=mock
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# 网关请求体的字段名（各家叫法不同，做成可配）
SMS_GATEWAY_PHONE_FIELD=phone
SMS_GATEWAY_TEMPLATE_FIELD=templateCode
SMS_GATEWAY_PARAMS_FIELD=params
SMS_TIMEOUT_MS=8000

# ---------- 12. 限流与配额 ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# 单用户同时运行的编排数上限（文档 6.2.4）
MAX_CONCURRENT_RUNS=2

# ---------- 13. 日志 ----------
LOG_LEVEL=debug
# json（生产，便于采集）| pretty（开发，人可读）
LOG_FORMAT=pretty
# 日志中是否脱敏手机号/学号（生产必须 true）
LOG_MASK_SENSITIVE=true

# ---------- 14. 管理后台 ----------
ADMIN_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# 积分计费总开关（M1-06）
#   false = 免费开放（前期默认）：不预扣/不结清/不退回，也不产生积分流水，全部功能免费使用
#   true  = 按积分计费：恢复完整的预扣 → 转正 / 退回三条路径
#   切换只改这一个变量，不需要改代码或改数据；详见 docs/dev/BILLING-MODES.md
BILLING_ENABLED=false

# ---------- 15. 业务参数 ----------
# 平台服务费：5% 且封顶 20 元（任务清单 M3-13）
PLATFORM_FEE_RATE=0.05
PLATFORM_FEE_CAP_CENTS=2000
# 订单自动关闭/自动验收（小时/天）
ORDER_PAY_TIMEOUT_MINUTES=30
ORDER_AUTO_ACCEPT_DAYS=7
# 上传大小上限（MB，文档 6.5）
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_VIDEO_MB=500
UPLOAD_MAX_DOC_MB=100
# 产物文件保留天数（文档 6.4.5）
FILE_RETENTION_DAYS=30
