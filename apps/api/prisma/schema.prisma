// 《青智校园》数据库 Schema（文档第 8 章 / 任务清单 M0-10）
// 数据库：MySQL 8.0+（InnoDB / utf8mb4）
// 纪律：
//   1) 金额一律用 Int（单位：分），禁止 Float/Decimal
//   2) 状态字段用 String + 枚举常量（由 @qz/core 统一维护）
//   3) 所有软关联字段建索引（见 @@index）
//   4) 半结构化数据（计划、参数、结果）用 Json
//   5) MySQL 不支持标量数组：原 String[] 字段一律落为 Json 数组，
//      读写请走 @qz/core 的 asStringArray()/asJsonArray()，禁止直接当 string[] 用
//   6) 主键统一 Char(36) 存 UUID 字符串（MySQL 无原生 uuid 类型）
// 迁移说明：见 docs/architecture/DB-MIGRATION-POSTGRES-TO-MYSQL.md

generator client {
  provider      = "prisma-client-js"
  // 本机开发是 Windows，但部署目标（docker-compose / 云主机）是 Linux。
  // 不显式声明则只生成 native 引擎，产物进 Linux 容器后会在启动时报
  // "Query engine binary for current platform ... could not be found"。
  // 加 debian-openssl-3.0.x 覆盖 Debian 12 / Ubuntu 22.04+（本项目部署基线）。
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // 影子库：prisma migrate dev 需要一个可随意清空的库来做迁移预演。
  // 本机安装与 Docker 的 MYSQL_USER 都只授权到业务库，不会自动提供影子库，
  // 故显式指定（由 scripts/db/init-db.sql 或 scripts/db/mysql-bootstrap.sql 创建）。
  // 注意：prisma migrate deploy（生产）会忽略此配置，但 env() 仍要求变量存在。
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// 一、用户与权限
// ============================================================

model School {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(120)
  code      String   @unique @db.VarChar(40)
  city      String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  announcements Announcement[]
  activities    Activity[]

  @@map("school")
}

model User {
  id        String    @id @default(uuid()) @db.Char(36)
  openid    String    @unique @db.VarChar(64)
  unionid   String?   @db.VarChar(64)
  phone     String?   @unique @db.VarChar(20)
  nickname  String?   @db.VarChar(40)
  avatar    String?   @db.VarChar(500)
  schoolId  String?   @map("school_id") @db.Char(36)
  college   String?   @db.VarChar(60)
  grade     String?   @db.VarChar(20)
  /// 取值见 `packages/core` 的 Gender 枚举（male / female / unspecified）；
  /// null = 还没填过，unspecified = 用户主动选了"不想说"，两者界面提示不同
  gender    String?   @db.VarChar(12)
  realName  String?   @map("real_name") @db.VarChar(40)
  status    String    @default("active") @db.VarChar(20)
  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school           School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  roles            UserRole[]
  adminAccount     AdminAccount?
  profile          UserProfile?
  verifications    Verification[]
  files            FileAsset[]
  jobs             ToolJob[]
  sessions         OsSession[]
  tasks            Task[]             @relation("TaskPublisher")
  applications     TaskApplication[]
  ordersAsBuyer    Order[]            @relation("OrderBuyer")
  ordersAsProvider Order[]            @relation("OrderProvider")
  ledgers          WalletLedger[]
  pointsLedgers    PointsLedger[]
  reviewsWritten   Review[]           @relation("ReviewAuthor")
  reviewsGot       Review[]           @relation("ReviewTarget")
  creditLogs       CreditLog[]
  services         Service[]
  notifications    Notification[]
  wallet           Wallet?
  wordBooks        UserWordBook[]
  wordProgress     UserWordProgress[]
  wordStudyLogs    WordStudyLog[]
  practiceProgress PracticeProgress[]
  practiceAttempts PracticeAttempt[]
  practiceLogs     PracticeStudyLog[]

  @@index([schoolId])
  @@index([status, createdAt])
  @@map("user")
}

/// 一账号多身份（文档 ADR-06 / 6.1.2）
model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  role      String   @db.VarChar(20)
  scope     String   @default("self") @db.VarChar(20)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, status])
  @@map("user_role")
}

/// 用户画像：信用分 + 积分 + 技能 + 统计（文档 6.1.3 / 6.6.4）
model UserProfile {
  userId          String    @id @map("user_id") @db.Char(36)
  creditScore     Int       @default(80) @map("credit_score")
  skills          Json      @default("[]")
  bio             String?   @db.VarChar(300)
  tags            Json      @default("[]")
  points          Int       @default(0)
  balance         Int       @default(0)
  frozen          Int       @default(0)
  totalIncome     Int       @default(0) @map("total_income")
  completedOrders Int       @default(0) @map("completed_orders")
  ratingSum       Int       @default(0) @map("rating_sum")
  ratingCount     Int       @default(0) @map("rating_count")
  acceptOrders    Boolean   @default(true) @map("accept_orders")
  lastActiveAt    DateTime? @map("last_active_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creditScore])
  @@index([lastActiveAt])
  @@map("user_profile")
}

/// 认证申请（学生证 / 技能 / 商户）（文档 5.3.12）
model Verification {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  type         String    @db.VarChar(20)
  materials    Json      @default("[]")
  skillTags    Json      @default("[]") @map("skill_tags")
  status       String    @default("pending") @db.VarChar(20)
  rejectReason String?   @map("reject_reason") @db.VarChar(300)
  reviewerId   String?   @map("reviewer_id") @db.Char(36)
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  /// 申请时的身份信息**快照**。
  ///
  /// 为什么不直接读 `user.real_name`：审核要看到的是"**这次提交的**是谁"，
  /// 而不是"这个账号现在填的是谁"。用户事后改了资料，历史申请记录不能跟着变 ——
  /// 否则"当初凭什么通过的"就再也说不清了（申诉与追责都靠它）。
  /// `schoolId` 刻意**不做外键**：学校被删掉时，这条申请记录必须留下。
  realName  String? @map("real_name") @db.VarChar(40)
  studentNo String? @map("student_no") @db.VarChar(30)
  schoolId  String? @map("school_id") @db.Char(36)
  college   String? @db.VarChar(60)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([status, createdAt])
  @@map("verification")
}

// ============================================================
// 二、文件资产（文档 6.5.6）
// ============================================================

model FileAsset {
  id            String    @id @default(uuid()) @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  name          String    @db.VarChar(200)
  type          String    @db.VarChar(20)
  size          Int
  objectKey     String    @map("object_key") @db.VarChar(400)
  thumbUrl      String?   @map("thumb_url") @db.VarChar(600)
  hash          String?   @db.VarChar(128)
  scene         String    @db.VarChar(30)
  source        String?   @db.VarChar(40)
  downloadCount Int       @default(0) @map("download_count")
  deletedAt     DateTime? @map("deleted_at")
  expireAt      DateTime? @map("expire_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expireAt])
  @@index([scene])
  @@map("file_asset")
}

// ============================================================
// 三、工具箱（文档 6.4）
// ============================================================

model ToolCategory {
  id      String  @id @db.VarChar(40)
  name    String  @db.VarChar(40)
  icon    String? @db.VarChar(120)
  sort    Int     @default(0)
  scene   String  @db.VarChar(30)
  /// 是否出现在工具箱的分类导航中。campus / system 为 Agent 内部能力域，用户不可见。
  visible Boolean @default(true)

  tools Tool[]

  @@map("tool_category")
}

model Tool {
  id                   String   @id @default(uuid()) @db.Char(36)
  name                 String   @unique @db.VarChar(60)
  displayName          String   @map("display_name") @db.VarChar(60)
  categoryId           String   @map("category_id") @db.VarChar(40)
  description          String   @db.VarChar(300)
  provider             String?  @db.VarChar(60)
  inputSchema          Json?    @map("input_schema")
  outputSchema         Json?    @map("output_schema")
  sync                 Boolean  @default(false)
  timeoutSec           Int      @default(300) @map("timeout_sec")
  price                Int      @default(0)
  permissions          Json     @default("[]")
  status               String   @default("planned") @db.VarChar(20)
  /// 是否出现在用户可见的工具箱目录中。
  /// campus / system 类工具（create_task、parse_requirement、search_knowledge、
  /// moderate_content 等）由 Agent 在编排中调用，不进工具箱 UI，故为 false。
  /// 用显式字段表达"不可见"，而不是靠"不录进数据库"——后者会让 Tool Registry 缺项。
  visible              Boolean  @default(true)
  requiresCopyrightAck Boolean  @default(false) @map("requires_copyright_ack")
  dailyQuota           Int      @default(0) @map("daily_quota")
  useCount             Int      @default(0) @map("use_count")
  version              String   @default("1.0.0") @db.VarChar(20)
  sort                 Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  category ToolCategory @relation(fields: [categoryId], references: [id])
  jobs     ToolJob[]

  @@index([categoryId, status])
  @@index([status, sort])
  @@index([visible, categoryId, sort])
  @@map("tool")
}

/// 工具执行作业（文档 6.5.1 Job 状态机）
model ToolJob {
  id             String    @id @default(uuid()) @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  toolName       String    @map("tool_name") @db.VarChar(60)
  params         Json      @default("{}")
  inputFiles     Json      @default("[]") @map("input_files")
  outputFiles    Json      @default("[]") @map("output_files")
  status         String    @default("queued") @db.VarChar(20)
  progress       Int       @default(0)
  stage          String?   @db.VarChar(120)
  cost           Int       @default(0)
  provider       String?   @db.VarChar(60)
  error          String?   @db.VarChar(600)
  /// 产出指标（体积/分辨率/时长/页数/字数…）。**让「成功但劣质」可被看见**：
  /// 此前压缩率、页数这些全不存在，于是劣质产物与优质产物在数据上长得一模一样，
  /// 用户只看到「共 N 个产物」。结构见 `apps/api/src/modules/job/job-result.ts`。
  result         Json      @default("{}")
  /// 质量分（0-100；仅 AI 类产出有，其余为 null）。由 @qz/core 的评分器产出
  qualityScore   Int?      @map("quality_score")
  /// 质量扣分项（人类可读，供结果页与排查用）
  qualityIssues  Json      @default("[]") @map("quality_issues")
  /// 实际尝试次数（1 = 一次过；2 = 质检不达标后重写了一次）。用于评估自修复效果
  attempts       Int       @default(1)
  runId          String?   @map("run_id") @db.Char(36)
  nodeId         String?   @map("node_id") @db.VarChar(40)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(80)
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool? @relation(fields: [toolName], references: [name])

  /// 幂等键**按用户唯一**（不是全局唯一）：同一用户的同一请求只执行一次，
  /// 不同用户各自使用相同的键互不干扰。改成全局唯一会让"用户 B 的提交被静默丢弃"。
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("tool_job")
}

// ============================================================
// 四、青智 OS（文档 6.2）
// ============================================================

model OsSession {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  title          String?  @db.VarChar(120)
  scene          String?  @db.VarChar(40)
  status         String   @default("active") @db.VarChar(20)
  contextSummary String?  @map("context_summary") @db.Text
  agentStack     Json     @default("[]") @map("agent_stack")
  tokenUsed      Int      @default(0) @map("token_used")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages OsMessage[]
  runs     OsPlanRun[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@map("os_session")
}

model OsMessage {
  id          String   @id @default(uuid()) @db.Char(36)
  sessionId   String   @map("session_id") @db.Char(36)
  role        String   @db.VarChar(20)
  agentName   String?  @map("agent_name") @db.VarChar(40)
  contentType String   @default("text") @map("content_type") @db.VarChar(20)
  content     String   @db.Text
  cards       Json?    @default("[]")
  toolCalls   Json?    @map("tool_calls")
  tokens      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  session OsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("os_message")
}

model OsPlanRun {
  id         String    @id @default(uuid()) @db.Char(36)
  sessionId  String    @map("session_id") @db.Char(36)
  goal       String    @db.Text
  plan       Json      @default("{}")
  status     String    @default("planning") @db.VarChar(30)
  progress   Int       @default(0)
  totalCost  Int       @default(0) @map("total_cost")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session OsSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nodes   OsTaskNode[]

  @@index([sessionId, status])
  @@map("os_plan_run")
}

/// 计划中的执行节点（文档 6.2.1 / 6.2.6）
model OsTaskNode {
  id          String   @id @default(uuid()) @db.Char(36)
  runId       String   @map("run_id") @db.Char(36)
  nodeId      String   @map("node_id") @db.VarChar(40)
  name        String   @db.VarChar(120)
  type        String   @db.VarChar(20)
  agent       String?  @db.VarChar(40)
  tool        String?  @db.VarChar(60)
  depends     Json     @default("[]")
  status      String   @default("pending") @db.VarChar(30)
  progress    Int      @default(0)
  attempt     Int      @default(0)
  result      Json?
  error       String?  @db.VarChar(600)
  hitlType    String?  @map("hitl_type") @db.VarChar(20)
  hitlPayload Json?    @map("hitl_payload")
  refTaskId   String?  @map("ref_task_id") @db.Char(36)
  skillTags   Json     @default("[]") @map("skill_tags")
  budget      Int      @default(0)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  run OsPlanRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId, status])
  @@map("os_task_node")
}

/// Agent 定义（文档 6.3.1）
model AgentDef {
  name          String   @id @db.VarChar(40)
  displayName   String   @map("display_name") @db.VarChar(60)
  description   String   @db.VarChar(400)
  systemPrompt  String   @map("system_prompt") @db.Text
  tools         Json     @default("[]")
  permissions   Json     @default("[]")
  inputSchema   Json?    @map("input_schema")
  outputSchema  Json?    @map("output_schema")
  modelPolicy   Json?    @map("model_policy")
  maxSteps      Int      @default(5) @map("max_steps")
  status        String   @default("active") @db.VarChar(20)
  fallbackAgent String?  @map("fallback_agent") @db.VarChar(40)
  version       String   @default("1.0.0") @db.VarChar(20)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("agent_def")
}

/// Agent 调用日志（成本看板，文档 6.10.1）
model AgentCallLog {
  id               String   @id @default(uuid()) @db.Char(36)
  runId            String?  @map("run_id") @db.Char(36)
  sessionId        String?  @map("session_id") @db.Char(36)
  agentName        String   @map("agent_name") @db.VarChar(40)
  model            String?  @db.VarChar(60)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")
  status           String   @default("succeeded") @db.VarChar(20)
  error            String?  @db.VarChar(600)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([agentName, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("agent_call_log")
}

// ============================================================
// 五、青智驿站（文档 6.6）
// ============================================================

/// 服务分类（摄影 / 设计 / 文案 / 编程 …）
model ServiceCategory {
  id   String  @id @db.VarChar(40)
  name String  @db.VarChar(40)
  icon String? @db.VarChar(120)
  sort Int     @default(0)

  services Service[]
  tasks    Task[]

  @@map("service_category")
}

/// 服务商品（服务者预先上架的标准商品）
model Service {
  id           String   @id @default(uuid()) @db.Char(36)
  providerId   String   @map("provider_id") @db.Char(36)
  categoryId   String   @map("category_id") @db.VarChar(40)
  title        String   @db.VarChar(80)
  description  String   @db.Text
  cover        String?  @db.VarChar(600)
  price        Int      @default(0)
  priceUnit    String   @default("fixed") @map("price_unit") @db.VarChar(20)
  deliveryDays Int      @default(3) @map("delivery_days")
  serviceArea  String   @default("school") @map("service_area") @db.VarChar(20)
  skillTags    Json     @default("[]") @map("skill_tags")
  status       String   @default("draft") @db.VarChar(20)
  orderCount   Int      @default(0) @map("order_count")
  viewCount    Int      @default(0) @map("view_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  provider User            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  orders   Order[]

  @@index([status, categoryId])
  @@index([providerId, status])
  @@map("service")
}

/// 需求（任务）（文档 6.6.1）
model Task {
  id                 String    @id @default(uuid()) @db.Char(36)
  taskNo             String    @unique @map("task_no") @db.VarChar(40)
  publisherId        String    @map("publisher_id") @db.Char(36)
  categoryId         String    @map("category_id") @db.VarChar(40)
  title              String    @db.VarChar(80)
  description        String    @db.Text
  budget             Int       @default(0)
  budgetType         String    @default("fixed") @map("budget_type") @db.VarChar(20)
  deadline           DateTime?
  location           String?   @db.VarChar(160)
  skillTags          Json      @default("[]") @map("skill_tags")
  attachments        Json      @default("[]")
  /// manual | ai_generated | os_plan（闭环回流的关键）
  source             String    @default("manual") @db.VarChar(20)
  refRunId           String?   @map("ref_run_id") @db.Char(36)
  status             String    @default("draft") @db.VarChar(30)
  applyCount         Int       @default(0) @map("apply_count")
  viewCount          Int       @default(0) @map("view_count")
  selectedProviderId String?   @map("selected_provider_id") @db.Char(36)
  publishedAt        DateTime? @map("published_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  publisher    User              @relation("TaskPublisher", fields: [publisherId], references: [id], onDelete: Cascade)
  category     ServiceCategory   @relation(fields: [categoryId], references: [id])
  applications TaskApplication[]
  orders       Order[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([publisherId, status])
  @@index([refRunId])
  @@map("task")
}

/// 报名 / 抢单
model TaskApplication {
  id         String   @id @default(uuid()) @db.Char(36)
  taskId     String   @map("task_id") @db.Char(36)
  providerId String   @map("provider_id") @db.Char(36)
  quote      Int      @default(0)
  message    String?  @db.VarChar(500)
  matchScore Int      @default(0) @map("match_score")
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([taskId, providerId])
  @@index([providerId, status])
  @@index([taskId, matchScore(sort: Desc)])
  @@map("task_application")
}

// ============================================================
// 六、订单与交易（文档 6.6.3）
// ============================================================

model Order {
  id              String    @id @default(uuid()) @db.Char(36)
  orderNo         String    @unique @map("order_no") @db.VarChar(40)
  taskId          String?   @map("task_id") @db.Char(36)
  serviceId       String?   @map("service_id") @db.Char(36)
  buyerId         String    @map("buyer_id") @db.Char(36)
  providerId      String    @map("provider_id") @db.Char(36)
  amount          Int
  platformFee     Int       @default(0) @map("platform_fee")
  providerIncome  Int       @default(0) @map("provider_income")
  status          String    @default("pending_payment") @db.VarChar(30)
  revisionCount   Int       @default(0) @map("revision_count")
  requirement     String?   @db.Text
  deliveryFiles   Json      @default("[]") @map("delivery_files")
  deliveryRemark  String?   @map("delivery_remark") @db.VarChar(500)
  cancelReason    String?   @map("cancel_reason") @db.VarChar(300)
  refundReason    String?   @map("refund_reason") @db.VarChar(300)
  payDeadline     DateTime? @map("pay_deadline")
  deliverDeadline DateTime? @map("deliver_deadline")
  paidAt          DateTime? @map("paid_at")
  startedAt       DateTime? @map("started_at")
  deliveredAt     DateTime? @map("delivered_at")
  acceptedAt      DateTime? @map("accepted_at")
  completedAt     DateTime? @map("completed_at")
  refundedAt      DateTime? @map("refunded_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  task     Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  buyer    User            @relation("OrderBuyer", fields: [buyerId], references: [id])
  provider User            @relation("OrderProvider", fields: [providerId], references: [id])
  timeline OrderTimeline[]
  payment  Payment?
  reviews  Review[]

  @@index([buyerId, status])
  @@index([providerId, status])
  @@index([status, payDeadline])
  @@index([status, deliverDeadline])
  @@map("order")
}

/// 订单时间线（所有状态变更留痕）
model OrderTimeline {
  id         String   @id @default(uuid()) @db.Char(36)
  orderId    String   @map("order_id") @db.Char(36)
  event      String   @db.VarChar(60)
  operatorId String?  @map("operator_id") @db.Char(36)
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_timeline")
}

/// 支付记录（微信支付单号）
model Payment {
  id           String    @id @default(uuid()) @db.Char(36)
  orderId      String    @unique @map("order_id") @db.Char(36)
  payNo        String?   @unique @map("pay_no") @db.VarChar(64)
  channel      String    @default("wechat") @db.VarChar(20)
  amount       Int
  status       String    @default("pending") @db.VarChar(20)
  refundAmount Int       @default(0) @map("refund_amount")
  refundNo     String?   @map("refund_no") @db.VarChar(64)
  paidAt       DateTime? @map("paid_at")
  refundedAt   DateTime? @map("refunded_at")
  rawCallback  Json?     @map("raw_callback")
  createdAt    DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payment")
}

/// 钱包余额（冗余快照，便于快速查询）
model Wallet {
  userId      String   @id @map("user_id") @db.Char(36)
  balance     Int      @default(0)
  frozen      Int      @default(0)
  totalIncome Int      @default(0) @map("total_income")
  points      Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet")
}

/// 资金流水（唯一真相来源，只增不改）
model WalletLedger {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  type         String   @db.VarChar(20)
  amount       Int
  balanceAfter Int      @map("balance_after")
  refType      String?  @map("ref_type") @db.VarChar(30)
  refId        String?  @map("ref_id") @db.VarChar(60)
  remark       String?  @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([refType, refId])
  @@map("wallet_ledger")
}

/// 积分流水（文档 6.11）
model PointsLedger {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  delta        Int
  reason       String    @db.VarChar(60)
  refId        String?   @map("ref_id") @db.VarChar(60)
