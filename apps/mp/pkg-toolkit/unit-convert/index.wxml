<!-- 单位换算（校园小工具）
     视觉：工具主题 · 组别 → 输入 → 结果 + 常用对照，纯本地计算，无网络请求
     装饰签名（见 docs/dev/MP-VISUAL-SYSTEM.md）：halo + dot-a -->
<view
  class="qz-page th-toolkit unit-convert"
  bindtouchstart="onFxStart"
  bindtouchmove="onFxMove"
  bindtouchend="onFxEnd"
  bindtouchcancel="onFxEnd"
>
  <!-- 装饰层（不拦截点击；只有装饰层跟随指针，内容区不跟随） -->
  <view class="qz-deco">
    <view class="qz-fx" style="{{fxStyle}}">
      <view class="uc-halo qz-halo"></view>
      <view class="qz-dot qz-dot-a"></view>
    </view>
  </view>

  <view class="qz-content">
    <view class="qz-head">
      <view class="qz-head-row qz-an-in">
        <view class="qz-ico qz-ico-l qz-ico-float">
          <view class="qz-i qz-i-chart"></view>
        </view>
        <view class="qz-head-main">
          <text class="qz-head-title">单位换算</text>
          <text class="qz-head-sub">本地计算、不上传、不占额度</text>
        </view>
      </view>
    </view>

    <view class="qz-container">
      <!-- ---------- 组别 ---------- -->
      <view class="qz-card qz-an-in qz-d1">
        <view class="card-title">
          <text>换算哪一类</text>
          <text class="card-title-hint">切一类会立即重算，并换成该类的常用单位</text>
        </view>

        <view class="chips">
          <view
            class="qz-chip qz-press {{groupIndex === index ? 'qz-chip-on' : ''}}"
            wx:for="{{chips}}"
            wx:key="key"
            data-index="{{index}}"
            bindtap="onGroupTap"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <!-- ---------- 输入 ---------- -->
      <view class="qz-card qz-card-grad qz-an-in qz-d2">
        <view class="card-title">
          <text>换算</text>
          <text class="card-title-hint">{{fromLabel}} → {{toLabel}}</text>
        </view>

        <view class="value-row">
          <input
            class="value-input"
            type="digit"
            value="{{valueText}}"
            placeholder="如 1.75"
            placeholder-class="value-ph"
            bindinput="onValueInput"
          />
          <text class="value-unit">{{fromLabel}}</text>
        </view>

        <view class="unit-row">
          <picker
            class="picker"
            mode="selector"
            range="{{units}}"
            range-key="label"
            value="{{fromIndex}}"
            bindchange="onFromChange"
          >
            <view class="pick qz-press">
              <text class="pick-tag">从</text>
              <text class="pick-value">{{fromLabel}}</text>
              <text class="pick-arrow">›</text>
            </view>
          </picker>

          <view class="swap qz-press" bindtap="onSwap">⇄</view>

          <picker
            class="picker"
            mode="selector"
            range="{{units}}"
            range-key="label"
            value="{{toIndex}}"
            bindchange="onToChange"
          >
            <view class="pick qz-press">
              <text class="pick-tag">到</text>
              <text class="pick-value">{{toLabel}}</text>
              <text class="pick-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <!-- ---------- 结果 / 空态（三态互斥，都不带 wx:for） ---------- -->
      <view class="qz-card qz-card-glow result qz-an-in qz-d3" wx:if="{{status === 'ok'}}">
        <text class="result-src">{{srcText}}</text>
        <view class="result-body">
          <text class="result-num">{{resultText}}</text>
          <text class="result-unit">{{toLabel}}</text>
        </view>
        <view class="result-ratio qz-card-tint">
          <text class="ratio-text">{{ratioText}}</text>
        </view>
        <text class="hint">换单位或改数字都会立刻重算，不用点提交。</text>
      </view>

      <view class="qz-card blank qz-an-in qz-d3" wx:elif="{{status === 'invalid'}}">
        <text class="blank-title">{{invalidText}}</text>
        <text class="hint">只填数字就行，比如 1.75、1024、0.5；单位在上面两个框里选。</text>
      </view>

      <view class="qz-card blank qz-an-in qz-d3" wx:else>
        <text class="blank-title">填一个数，结果立刻出来</text>
        <text class="hint">
          换算只在这台手机上完成，不联网、不上传、不占额度。
          小数直接打，改一位就重算一位；组别切来切去，数字会跟着走。
        </text>
      </view>

      <!-- ---------- 常用对照 ---------- -->
      <view class="qz-card qz-card-line qz-an-in qz-d4" wx:if="{{rows.length}}">
        <view class="card-title">
          <text>常用对照</text>
          <text class="card-title-hint">{{srcPlain}} 换成这一组的其余单位</text>
        </view>

        <view class="conv-row" wx:for="{{rows}}" wx:key="key">
          <text class="conv-label">{{item.label}}</text>
          <text class="conv-value">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
