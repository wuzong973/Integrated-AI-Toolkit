# 容器口令模板（只给 docker-compose.prod.yml 用，不含应用自己的 .env 变量）
#
# 用法（服务器上）：
#   cp compose.env.example compose.env && chmod 600 compose.env
#   docker compose -f docker-compose.prod.yml --env-file compose.env up -d
#
# ⚠️ compose.env **严禁入库**（红线：.env 类文件不进仓库）。本文件只是模板，全部留空。
# ⚠️ compose 文件里这些变量都写成 `${VAR:?}`，留空会让 compose 直接报错退出，
#    而不是悄悄用示例弱口令起一个公网可猜的库 —— 这台机器上还跑着另外两个项目。
#
# 生成口令：openssl rand -base64 24

# --- MySQL 8.4（容器 qz-mysql，宿主机 127.0.0.1:3308）---
QZ_MYSQL_ROOT_PASSWORD=
QZ_MYSQL_PASSWORD=
# 库名/账号一般不用改：init-db.sql 与 Prisma 迁移都按这两个值授权影子库
QZ_MYSQL_DATABASE=qingzhi
QZ_MYSQL_USER=qz

# --- MinIO（容器 qz-minio，宿主机 127.0.0.1:9120）---
# 注意：这是 MinIO 的 root 口令，与应用侧 STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY
# 是两套凭据。生产应另建一个只有该 bucket 权限的 service account 给应用用，
# 不要把 root 口令填进应用的 .env。
QZ_MINIO_ROOT_USER=
QZ_MINIO_ROOT_PASSWORD=
QZ_MINIO_BUCKET=qingzhi-prod

# --- Qdrant（容器 qz-qdrant，宿主机 127.0.0.1:6333）---
# 对应 .env 里的 QDRANT_API_KEY。虽然只绑环回，但同机其他项目一旦被拿下就能免钥读写向量库，
# 所以这里必须有值。
QZ_QDRANT_API_KEY=
