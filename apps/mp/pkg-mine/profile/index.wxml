<!-- 个人信息编辑（M0-20 补充）
     视觉：th-mine · 装饰签名 curve + halo（登记于 MP-VISUAL-SYSTEM §十一）
     头像与昵称走微信官方的"头像昵称填写能力"：button open-type="chooseAvatar" +
     input type="nickname"，用户点下去时微信会把自己当前的头像/昵称摆在第一位。 -->
<view
  class="qz-page th-mine profile"
  bindtouchstart="onFxStart"
  bindtouchmove="onFxMove"
  bindtouchend="onFxEnd"
  bindtouchcancel="onFxEnd"
>
  <view class="qz-deco">
    <view class="qz-fx" style="{{fxStyle}}">
      <view class="profile-curve qz-curve"></view>
      <view class="profile-halo qz-halo"></view>
    </view>
  </view>

  <view class="qz-content">
    <view class="qz-head">
      <view class="qz-head-row">
        <view class="qz-ico qz-ico-l qz-ico-float"><view class="qz-i qz-i-mine"></view></view>
        <view class="qz-head-main">
          <text class="qz-head-title">个人信息</text>
          <text class="qz-head-sub">头像和昵称可以直接用你的微信资料</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="qz-container">
      <view class="qz-card qz-an-in"><text class="form-tip">加载中…</text></view>
    </view>

    <view wx:elif="{{loadError}}" class="qz-container">
      <view class="qz-empty qz-an-in">
        <view class="qz-empty-ico qz-ico qz-ico-xl qz-ico-float">
          <view class="qz-i qz-i-empty"></view>
        </view>
        <text class="qz-empty-title">没读到你的资料</text>
        <text class="qz-empty-text">{{loadError}}</text>
        <view class="qz-empty-flow qz-flow"></view>
        <view class="qz-btn-main qz-press" bindtap="onRetry">重新加载</view>
      </view>
    </view>

    <view wx:else class="qz-container">
      <!-- 头像：整个圆都是一枚 open-type 按钮，微信的头像选择器由它拉起 -->
      <view class="avatar-block qz-card qz-an-in qz-d1">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <view class="avatar-ring">
            <view class="avatar-ring-line"></view>
            <image wx:if="{{avatarPreview}}" class="avatar" src="{{avatarPreview}}" mode="aspectFill" />
            <view wx:else class="avatar avatar-ph">
              <view class="qz-i qz-i-mine avatar-ico"></view>
            </view>
          </view>
          <view class="avatar-badge">
            <view class="qz-ico qz-ico-s"><view class="qz-i qz-i-photo"></view></view>
          </view>
        </button>
        <text class="avatar-hint">{{avatarDraft ? '已选择新头像，保存后生效' : '点击更换头像'}}</text>
      </view>

      <!-- 昵称：type="nickname" 让微信在失焦时填入用户的小程序昵称 -->
      <view class="qz-card qz-an-in qz-d2">
        <view class="form-row">
          <text class="form-label">昵称</text>
          <input
            class="form-input"
            type="nickname"
            maxlength="30"
            placeholder="给自己起个名字"
            value="{{form.nickname}}"
            data-field="nickname"
            bindinput="onFieldInput"
            bindblur="onNicknameBlur"
          />
        </view>

        <view class="form-row form-row-col">
          <text class="form-label">性别</text>
          <view class="gender-chips">
            <view
              wx:for="{{genderOptions}}"
              wx:key="value"
              class="gender-chip {{form.gender === item.value ? 'gender-chip-on' : ''}} qz-press"
              data-value="{{item.value}}"
              bindtap="onPickGender"
            >
              {{item.label}}
            </view>
          </view>
          <text wx:if="{{!form.gender}}" class="form-tip">还没选过，选一次就不再问了</text>
        </view>

        <view class="form-row">
          <text class="form-label">手机号</text>
          <input
            class="form-input"
            type="number"
            maxlength="11"
            placeholder="未填写"
            value="{{form.phone}}"
            bindinput="onPhoneInput"
          />
          <text class="form-tag {{phoneTouched ? 'form-tag-warn' : ''}}">未验证</text>
        </view>
        <text class="form-tip">手机号由你自行填写，平台未做真实性校验，仅用于联系与对账</text>

        <view class="form-row">
          <text class="form-label">学院</text>
          <input
            class="form-input"
            maxlength="60"
            placeholder="选填"
            value="{{form.college}}"
            data-field="college"
            bindinput="onFieldInput"
          />
        </view>

        <view class="form-row">
          <text class="form-label">年级</text>
          <input
            class="form-input"
            maxlength="20"
            placeholder="选填，如 2023 级"
            value="{{form.grade}}"
            data-field="grade"
            bindinput="onFieldInput"
          />
        </view>
      </view>

      <view class="qz-card qz-an-in qz-d3">
        <view class="form-row form-row-col">
          <text class="form-label">个人简介</text>
          <textarea
            class="form-textarea"
            maxlength="200"
            placeholder="一句话介绍你会什么、想接什么样的活"
            value="{{form.bio}}"
            data-field="bio"
            bindinput="onFieldInput"
          />
          <text class="form-count">{{bioLength}}/200</text>
        </view>
      </view>

      <text class="form-foot">昵称与简介会公开展示在订单、评价和服务者列表里，请避免出现联系方式</text>
    </view>
  </view>

  <!-- 固定底部保存栏：安全区与层级由全局 .qz-footer-bar 负责，本页只排内容 -->
  <view wx:if="{{!loading && !loadError}}" class="qz-footer-bar">
    <view class="save-row">
      <view class="save-state">{{saveStateText}}</view>
      <view
        class="save-btn {{dirty && !saving ? '' : 'save-btn-off'}} qz-press"
        bindtap="onSave"
      >
        {{saving ? '保存中…' : '保存'}}
      </view>
    </view>
  </view>
</view>
